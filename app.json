{
  "expo": {
    "name": "EasyAudit",
    "slug": "postora",
    "scheme": "postora",
    "version": "1.0.13",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1f3d"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mobiletestemauricio.postora",
      "versionCode": 14
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O EasyAudit usa suas fotos para definir a foto de perfil.",
          "cameraPermission": "O EasyAudit usa a câmera para tirar a foto de perfil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O EasyAudit usa a câmera para ler o código de barras nas contagens e para a foto de perfil.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withCmakeObjectPathMax.js",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "EasyAudit",
      "shortName": "EasyAudit",
      "themeColor": "#0f1f3d",
      "backgroundColor": "#f4f3ef"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2d77110f-dee3-4eaf-9221-68edcfd802e8"
      }
    },
    "runtimeVersion": "1.0.13",
    "updates": {
      "url": "https://u.expo.dev/2d77110f-dee3-4eaf-9221-68edcfd802e8",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
