{
  "expo": {
    "name": "Postora",
    "slug": "postora",
    "scheme": "postora",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04142f"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mobiletestemauricio.postora",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Postora usa suas fotos para definir a foto de perfil.",
          "cameraPermission": "O Postora usa a câmera para tirar a foto de perfil."
        }
      ],
      "./plugins/withCmakeObjectPathMax.js"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Postora",
      "shortName": "Postora",
      "themeColor": "#04142f",
      "backgroundColor": "#f5f6f8"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2d77110f-dee3-4eaf-9221-68edcfd802e8"
      }
    }
  }
}
